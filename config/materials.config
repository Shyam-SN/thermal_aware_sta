# =============================================================================
# Material Thermal Properties Configuration
# Thermal-Aware Pin-3D Framework for Ariane-136
# =============================================================================
#
# This file defines thermal conductivity (K), volumetric heat capacity (Cv),
# and Temperature Coefficient of Resistance (TCR / alpha) for all materials
# used in the 3D IC stack and interconnect routing layers.
#
# All values at reference temperature T_nom = 25°C (298.15 K)
#
# Format:
#   [material_name]
#   K        = <thermal_conductivity>  # [W/(m·K)]
#   Cv       = <volumetric_heat_cap>   # [J/(m³·K)]
#   alpha    = <TCR>                   # [K⁻¹] (for resistive materials)
#   notes    = <description>
#
# =============================================================================

# --- Reference Temperature ---
[global]
T_nom       = 25.0          # Reference temperature [°C]
T_wc        = 105.0         # Worst-case isothermal assumption [°C]

# =============================================================================
# Substrate & Semiconductor Materials
# =============================================================================

[silicon]
K           = 148.0         # Thermal conductivity [W/(m·K)] @ 25°C
Cv          = 1.63e6        # Volumetric heat capacity [J/(m³·K)]
alpha       = 0.0           # N/A for substrate
notes       = Bulk monocrystalline silicon. K is temperature-dependent:
              K(T) ≈ 148 * (300/T)^1.3 for T in Kelvin.
              For precision, use temperature-dependent model in PACT.

[silicon_thinned]
K           = 148.0         # Same material, different thickness in LCF
Cv          = 1.63e6
notes       = Thinned Si wafer (10-50 µm) for top tier.

# =============================================================================
# Dielectric & Insulator Materials
# =============================================================================

[sio2]
K           = 1.4           # Thermal conductivity [W/(m·K)]
Cv          = 1.65e6        # Volumetric heat capacity [J/(m³·K)]
notes       = Silicon dioxide (thermal oxide / ILD). Low K makes it a
              dominant thermal bottleneck in BEOL stacks.

[sicn]
K           = 2.0           # Thermal conductivity [W/(m·K)]
Cv          = 1.50e6
notes       = Silicon carbon nitride (SiCN). Used as etch stop and
              bonding passivation layer.

[low_k_ild]
K           = 0.5           # Thermal conductivity [W/(m·K)]
Cv          = 1.10e6
notes       = Low-K inter-layer dielectric (SiOCH, K_elec ≈ 2.5-3.0).
              Severely limits vertical heat conduction in BEOL.

# =============================================================================
# Metal & Interconnect Materials
# =============================================================================

[copper]
K           = 401.0         # Thermal conductivity [W/(m·K)]
Cv          = 3.44e6        # Volumetric heat capacity [J/(m³·K)]
alpha       = 0.00393       # TCR [K⁻¹] — primary value for wire scaling
rho_0       = 1.68e-8       # Bulk resistivity [Ω·m] @ 25°C
notes       = Dual-damascene Cu interconnect. Alpha used for
              R_thermal = R_nom * [1 + alpha * (T - T_nom)].
              Thin-film Cu may have higher effective resistivity due to
              grain boundary and surface scattering (Fuchs-Sondheimer).

[copper_heatsink]
K           = 401.0
Cv          = 3.44e6
notes       = Bulk copper for heat sink body.

[aluminum]
K           = 237.0         # Thermal conductivity [W/(m·K)]
Cv          = 2.43e6        # Volumetric heat capacity [J/(m³·K)]
alpha       = 0.00429       # TCR [K⁻¹]
rho_0       = 2.65e-8       # Bulk resistivity [Ω·m] @ 25°C
notes       = Al used in top metal layers or pad metallization.

[tungsten]
K           = 174.0         # Thermal conductivity [W/(m·K)]
Cv          = 2.58e6
alpha       = 0.0045        # TCR [K⁻¹]
rho_0       = 5.60e-8       # Bulk resistivity [Ω·m] @ 25°C
notes       = W used for contacts / local interconnect vias.

# =============================================================================
# Per-Metal-Layer TCR Values (NanGate45)
# =============================================================================
# These are the alpha values used by thermal_rcx.py for segment-level
# resistance scaling. Thin-film effects increase effective TCR slightly.

[metal1]
alpha       = 0.00393       # Cu M1 (thinnest, highest scattering)
width_nm    = 65
pitch_nm    = 130

[metal2]
alpha       = 0.00393       # Cu M2
width_nm    = 70
pitch_nm    = 140

[metal3]
alpha       = 0.00393       # Cu M3
width_nm    = 70
pitch_nm    = 140

[metal4]
alpha       = 0.00393       # Cu M4
width_nm    = 140
pitch_nm    = 280

[metal5]
alpha       = 0.00393       # Cu M5
width_nm    = 140
pitch_nm    = 280

[metal6]
alpha       = 0.00393       # Cu M6
width_nm    = 140
pitch_nm    = 280

[metal7]
alpha       = 0.00393       # Cu M7
width_nm    = 400
pitch_nm    = 800

[metal8]
alpha       = 0.00393       # Cu M8
width_nm    = 400
pitch_nm    = 800

[metal9]
alpha       = 0.00393       # Cu M9 (thick top metal)
width_nm    = 800
pitch_nm    = 1600

[metal10]
alpha       = 0.00429       # Al redistribution / pad layer
width_nm    = 2000
pitch_nm    = 4000

[metal11]
alpha       = 0.00393       # Cu M11 (HBT Interface)
width_nm    = 800
pitch_nm    = 1600

[metal12]
alpha       = 0.00393       # Cu M12 (Upper Tier M9 mirrored)
width_nm    = 800
pitch_nm    = 1600

[metal13]
alpha       = 0.00393       # Cu M13 (Upper Tier M8 mirrored)
width_nm    = 400
pitch_nm    = 800

[metal14]
alpha       = 0.00393       # Cu M14 (Upper Tier M7 mirrored)
width_nm    = 400
pitch_nm    = 800

[metal15]
alpha       = 0.00393       # Cu M15 (Upper Tier M6 mirrored)
width_nm    = 140
pitch_nm    = 280

[metal16]
alpha       = 0.00393       # Cu M16 (Upper Tier M5 mirrored)
width_nm    = 140
pitch_nm    = 280

[metal17]
alpha       = 0.00393       # Cu M17 (Upper Tier M4 mirrored)
width_nm    = 140
pitch_nm    = 280

[metal18]
alpha       = 0.00393       # Cu M18 (Upper Tier M3 mirrored)
width_nm    = 70
pitch_nm    = 140

[metal19]
alpha       = 0.00393       # Cu M19 (Upper Tier M2 mirrored)
width_nm    = 70
pitch_nm    = 140

[metal20]
alpha       = 0.00429       # Al M20 (Upper Tier M1 mirrored)
width_nm    = 65
pitch_nm    = 130


# =============================================================================
# Bonding & Interface Materials
# =============================================================================

[bonding_composite]
K           = 3.5           # Effective K [W/(m·K)] — weighted avg of
                             # Cu HBT pillars + SiO2/SiCN dielectric matrix
Cv          = 2.20e6
cu_fraction = 0.10          # ~10% area fill of Cu HBT pads
sio2_k      = 1.4
cu_k        = 401.0
notes       = Effective thermal conductivity for bonding interface layer.
              K_eff = cu_fraction * cu_k + (1 - cu_fraction) * sio2_k
              With 10% Cu fill: K_eff ≈ 0.10*401 + 0.90*1.4 ≈ 41.36
              But contact resistance and interface effects reduce this.
              Conservative estimate: 3.5 W/(m·K) for full layer.

[hbt_via]
alpha       = 0.00393       # Cu HBT pad TCR (same as Cu)
R_contact   = 0.5           # Contact resistance per HBT [Ω]
diameter_um = 5.0           # HBT pad diameter [µm]
pitch_um    = 10.0          # HBT pad pitch [µm]
notes       = Hybrid Bonding Terminal (HBT) for F2F bonding.
              Used for inter-tier signal routing and power delivery.

[miv_via]
alpha       = 0.00393       # Monolithic Inter-tier Via TCR
R_contact   = 5.0           # Higher R for MIV due to small diameter
diameter_um = 0.1           # MIV diameter [µm] (M3D)
pitch_um    = 0.5           # MIV pitch [µm]
notes       = Monolithic Inter-tier Via for M3D integration.
              Higher resistance than HBT due to nanoscale dimensions.

# =============================================================================
# Thermal Interface & Packaging Materials
# =============================================================================

[tim_compound]
K           = 5.0           # Thermal conductivity [W/(m·K)]
Cv          = 2.00e6
notes       = Thermal Interface Material (TIM). Typical indium-based or
              thermal grease compound. Range: 1-50 W/(m·K).

[fr4_pcb]
K           = 0.3           # Thermal conductivity [W/(m·K)]
Cv          = 1.50e6
notes       = FR4 PCB substrate. Very low K — primary thermal
              bottleneck for bottom-side heat dissipation.

[silicon_beol_composite]
K_lateral   = 65.0          # Effective lateral K [W/(m·K)]
K_vertical  = 20.0          # Effective vertical K [W/(m·K)]
Cv          = 2.00e6
notes       = Composite effective properties for active + BEOL stack.
              Lateral K higher due to metal lines; vertical K lower
              due to ILD layers between metal stacks. Values are
              geometry-dependent and should be calibrated per PDK.

# =============================================================================
# End of Material Configuration
# =============================================================================
